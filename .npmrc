# wrangler 4.x 把 @cloudflare/workers-types 声明为 peerOptional "^4"，
# 而本项目用的是 v5（types.ts 与 tsconfig 都指向它），npm 7+ 会因此在
# 安装阶段直接以 ERESOLVE 中止，连 tsc 都跑不到。
#
# 两者实际可以共存（本机就是这样装的），而且 workers-types 只是类型包，
# 运行时不参与打包，所以这里放开 peer 检查。
#
# 注意：CI 解析到的 wrangler 版本与本机可能不同（本机 4.144 的 peer 范围
# 已接受 v5，官方源上的 4.86 则要求 ^4），所以这个开关在两边都必须保留。
legacy-peer-deps=true
